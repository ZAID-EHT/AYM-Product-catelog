{
  "name": "aym-catalogue",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "import": "python scripts/import_catalogue.py",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run && python -m unittest discover -s tests -p test_import.py",
    "test:e2e": "python tests/browser_test.py",
    "test:regression": "python tests/jump_regression.py",
    "test:share": "python tests/share_export_test.py",
    "test:swipe": "python tests/swipe_test.py",
    "test:mobile": "python tests/mobile_viewer_test.py",
    "test:touch": "python tests/touch_gesture_test.py",
    "test:excel": "python tests/saved_excel_test.py",
    "check": "npm run test && npm run build",
    "format": "prettier --write src index.html vite.config.ts tsconfig.json package.json README.md public/sw.js public/manifest.webmanifest"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
